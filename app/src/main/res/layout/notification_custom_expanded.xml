<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/notif_bg">

    <!-- Top Header Bar: Icon + App Name + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/notifHeaderIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_whatsapp"
            android:contentDescription="Small icon" />

        <TextView
            android:id="@+id/notifAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WhatsApp"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/notif_header_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • now"
            android:textSize="12sp"
            android:textColor="@color/notif_header_text" />

    </LinearLayout>

    <!-- Content Row: Avatar + Sender & Full Message -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <ImageView
            android:id="@+id/notifAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_whatsapp_large"
            android:contentDescription="Avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notifSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mom ❤️"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/notif_title_text" />

            <TextView
                android:id="@+id/notifMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Are you coming home for dinner tonight? Don't forget to call me!"
                android:textSize="14sp"
                android:textColor="@color/notif_body_text" />

        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnNotifAction1"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:text="Reply"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/wa_teal" />

        <Button
            android:id="@+id/btnNotifAction2"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:layout_marginStart="8dp"
            android:text="Mark as read"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/notif_header_text" />

    </LinearLayout>

</LinearLayout>
