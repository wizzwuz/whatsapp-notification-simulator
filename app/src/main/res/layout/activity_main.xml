<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- Top AppBar with Theme Toggle Button -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bar_bg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_simulator"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_launcher_sim">

            <!-- Dark / Light Theme Toggle Button -->
            <ImageButton
                android:id="@+id/btnThemeToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle Dark Mode"
                android:src="@drawable/ic_dark_mode"
                app:tint="@color/white" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Live Notification Preview Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="LIVE NOTIFICATION PREVIEW"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_tertiary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/notif_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Preview Header: Icon + App Name + Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:id="@+id/ivPreviewSmallIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_whatsapp"
                            android:contentDescription="Platform icon"
                            app:tint="@color/notif_header_text" />

                        <TextView
                            android:id="@+id/tvPreviewAppName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WhatsApp"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/notif_header_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" • now"
                            android:textSize="12sp"
                            android:textColor="@color/notif_header_text" />

                    </LinearLayout>

                    <!-- Preview Body: Avatar + Sender & Message -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:id="@+id/ivPreviewAvatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_whatsapp_large"
                            android:contentDescription="Avatar" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPreviewSender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mom ❤️"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:textColor="@color/notif_title_text" />

                            <TextView
                                android:id="@+id/tvPreviewMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Are you coming home for dinner tonight?"
                                android:textSize="13sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textColor="@color/notif_body_text" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Preview Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tvPreviewAction1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Reply"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/wa_teal" />

                        <TextView
                            android:id="@+id/tvPreviewAction2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Mark as read"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/notif_header_text" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- App Platform Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_type_label"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <!-- App Choice Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAppType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAppWhatsApp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/app_type_whatsapp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAppGoogleMessages"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_type_google_messages" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sender Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutSender"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/sender_name_label"
                        app:startIconDrawable="@drawable/ic_person"
                        app:boxStrokeColor="@color/wa_teal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="textPersonName"
                            android:text="Mom ❤️" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/quick_senders"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <!-- Quick sender presets -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSender1"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mom ❤️" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSender2"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boss 💼" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSender3"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSender4"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1 (555) 019-2834" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Message Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutMessage"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/message_text_label"
                        app:startIconDrawable="@drawable/ic_message"
                        app:boxStrokeColor="@color/wa_teal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:lines="3"
                            android:textColor="@color/text_primary"
                            android:inputType="textMultiLine"
                            android:text="Are you coming home for dinner tonight? Don't forget to call me!" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/quick_messages"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <!-- Quick message templates -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMsgTemplate1"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hey, are you free now?" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMsgTemplate2"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="G-749201 is your Google verification code." />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMsgTemplate3"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Important: Call me ASAP!" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delay & Schedule Options Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delay_label"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <!-- Delay chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay5s"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="5s" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay10s"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10s" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay30s"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30s" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay1m"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 min" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay5m"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 min" />

                    </com.google.android.material.chip.ChipGroup>

                    <!-- Auto minimize option -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoMinimize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:checked="true"
                        android:text="Auto minimize app on trigger"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minimizes to home screen so the heads-up notification banner drops down from the top."
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <!-- Active Schedule Status Text -->
                    <TextView
                        android:id="@+id/tvScheduleStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#EFF6FF"
                        android:padding="12dp"
                        android:textColor="@color/google_blue_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="⏳ Scheduled: message arriving in 8s..."
                        tools:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestNow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_test_now"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:backgroundTint="@color/wa_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchedule"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_schedule"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_timer"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:strokeColor="@color/text_primary"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSchedule"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/btn_cancel_schedule"
                android:textColor="#EF4444"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
